#include <windows.h>

#define VER_FILEVERSION          @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
#define VER_FILEVERSION_STR      "@VER_MAJOR@.@VER_MINOR@.@VER_PATCH@.0\0"
#define VER_PRODUCTVERSION       @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
#define VER_PRODUCTVERSION_STR   "@VER_MAJOR@.@VER_MINOR@.@VER_PATCH@\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Laika"
            VALUE "FileDescription",  "GPU information tool for the llama.cpp-hub project"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "gpu-info"
            VALUE "LegalCopyright",   "Copyright (C) 2026. Open source."
            VALUE "OriginalFilename", "gpu-info-x64.exe"
            VALUE "ProductName",      "Easy GPU Tools"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
